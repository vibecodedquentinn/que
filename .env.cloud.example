# =============================================================================
# J.Ü.R.G.E.N. — NUR CLOUD (nichts auf Mac/iPad/NAS installieren)
# Diese Datei auf dem HOSTING-Anbieter als Umgebungsvariablen eintragen
# oder auf dem VPS als .env speichern. Siehe docs/CLOUD-NUR.md
# =============================================================================

PUBLIC_URL=https://juergen.deine-domain.de

# KI — optional; viel geht OHNE Key (Intent-Router)
# OpenRouter gratis: Konto + Key, Modell openrouter/free = 0 € (Tageslimit beachten)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_TEMPERATURE=0.35
# Paid upgrade (optional): LLM_MODEL=openai/gpt-4o-mini

ASSISTANT_NAME=J.Ü.R.G.E.N.
USER_TITLE=Max
DEFAULT_LANGUAGE=de

SMART_HOME_PROVIDER=mock

# Fritz!Box (WireGuard auf dem VPS — docs/FRITZBOX-CLOUD.md)
FRITZBOX_ENABLED=false
FRITZBOX_HOST=192.168.178.1
FRITZBOX_USER=
FRITZBOX_PASSWORD=

TTS_PROVIDER=piper
PIPER_VOICE=de_DE-thorsten-high

# Optional: Zugang absichern (Caddy Basic Auth, siehe Caddyfile.cloud)
# JUERGEN_BASIC_AUTH_USER=
# JUERGEN_BASIC_AUTH_HASH=
