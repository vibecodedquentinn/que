# =============================================================================
# J.Ü.R.G.E.N. — Beispiel-Konfiguration
# Kopieren:  cp .env.example .env
# =============================================================================

# --- Assistent ---
ASSISTANT_NAME=J.Ü.R.G.E.N.
ASSISTANT_ACRONYM=Joint Überwachungs-Regelungs-Gebäude-Energie-Navigator
USER_TITLE=Max
DEFAULT_LANGUAGE=de
PUBLIC_URL=https://192.168.1.10:8443

# --- LLM (OpenAI-kompatibles Protokoll) ---
# Cursor-Abonnement ≠ API für diese App. Siehe docs/EINRICHTUNG.md
#
# Option A — Ollama lokal (empfohlen, kostenlos, kein OpenAI nötig):
#   ollama pull llama3.2
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama
#
# Option B — OpenRouter (eine API, viele Modelle):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-sonnet-4
#
# Option C — OpenAI direkt:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Fritz!Box (optional, nur im Heimnetz) — docs/FRITZBOX.md ---
FRITZBOX_ENABLED=false
FRITZBOX_HOST=192.168.178.1
FRITZBOX_USER=
FRITZBOX_PASSWORD=

# --- Smart Home ---
SMART_HOME_PROVIDER=mock
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=

# --- Stimme ---
TTS_PROVIDER=piper
PIPER_URL=
PIPER_VOICE=de_DE-thorsten-high
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
